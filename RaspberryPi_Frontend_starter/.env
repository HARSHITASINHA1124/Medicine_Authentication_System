# Set this to the backend running on the Raspberry Pi.
# Example: http://127.0.0.1:8000
VITE_API_BASE_URL=http://127.0.0.1:8003

# IMPORTANT:
# Replace these two paths ONLY after checking the existing backend routes.
VITE_SCAN_ENDPOINT=/api/scans/
VITE_ML_ENDPOINT=/api/scans/analyze
VITE_RESULT_ENDPOINT=/YOUR_EXISTING_RESULT_ENDPOINT

# Optional health endpoint if your backend already has one.
VITE_HEALTH_ENDPOINT=/health
